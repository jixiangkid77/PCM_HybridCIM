tee -o /mnt/d/Project/hybrid_memory/paper2/reports/e9/e9_1/syn/amu9_stat_final.txt stat -liberty /home/kid/sky130/orfs/flow/platforms/sky130hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
