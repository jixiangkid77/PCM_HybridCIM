# P2R-E8.5: amu_top, flow B of P2R-E3 (Yosys 0.68+36). Same commands as
# scripts/yosys_e3s1_b.ys + yosys_e3s2_b.ys, in one process.
read_liberty -lib /home/kid/sky130/orfs/flow/platforms/sky130hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
read_verilog -sv -DMODEL_B -I /mnt/d/Project/hybrid_memory/paper2/rtl/e8 /mnt/d/Project/hybrid_memory/paper2/rtl/e8/amu_entry.v /mnt/d/Project/hybrid_memory/paper2/rtl/e8/amu_lanes.v /mnt/d/Project/hybrid_memory/paper2/rtl/e8/amu_core.v /mnt/d/Project/hybrid_memory/paper2/rtl/e8/amu_buf.v /mnt/d/Project/hybrid_memory/paper2/rtl/e8/amu_pflags.v /mnt/d/Project/hybrid_memory/paper2/rtl/e8/amu_table.v /mnt/d/Project/hybrid_memory/paper2/rtl/e8/amu_top.v
read_verilog -sv /mnt/d/Project/hybrid_memory/paper2/rtl/e8/e8_rom_r48_stub.v
synth -top amu_top
tee -o /mnt/d/Project/hybrid_memory/paper2/reports/e8_rom/e8_5/amu_B_stat_after_synth.txt stat

dfflegalize -cell $_DFF_?_ 01 -cell $_DFFE_??_ 01 -cell $_DFF_???_ 01 -cell $_DFFE_????_ 01 -cell $_SDFFCE_????_ 01
opt_expr
opt_merge
opt_clean
tee -o /mnt/d/Project/hybrid_memory/paper2/reports/e8_rom/e8_5/amu_B_stat_after_transform.txt stat

clockgate -liberty /home/kid/sky130/orfs/flow/platforms/sky130hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib -dont_use sky130_fd_sc_hd__sdlclkp*
tee -o /mnt/d/Project/hybrid_memory/paper2/reports/e8_rom/e8_5/amu_B_stat_after_clockgate.txt stat

dfflibmap -liberty /home/kid/sky130/orfs/flow/platforms/sky130hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib -dont_use sky130_fd_sc_hd__lpflow_* -dont_use sky130_fd_sc_hd__probe*
abc -liberty /home/kid/sky130/orfs/flow/platforms/sky130hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib -dont_use sky130_fd_sc_hd__lpflow_* -dont_use sky130_fd_sc_hd__probe*
clean

tee -o /mnt/d/Project/hybrid_memory/paper2/reports/e8_rom/e8_5/amu_B_stat_final.txt stat -liberty /home/kid/sky130/orfs/flow/platforms/sky130hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
write_verilog /mnt/d/Project/hybrid_memory/paper2/reports/e8_rom/e8_5/amu_top_B_netlist.v
write_verilog -noattr /mnt/d/Project/hybrid_memory/paper2/reports/e8_rom/e8_5/amu_top_B_sta.v
