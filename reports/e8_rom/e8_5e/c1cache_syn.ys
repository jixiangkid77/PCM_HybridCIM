read_verilog -sv /mnt/d/Project/hybrid_memory/paper2/rtl/e8/conv1_cache.v
synth -top conv1_cache
tee -o /mnt/d/Project/hybrid_memory/paper2/reports/e8_rom/e8_5e/c1cache_stat_after_synth.txt stat

dfflegalize -cell $_DFF_?_ 01 -cell $_DFFE_??_ 01 -cell $_DFF_???_ 01 -cell $_DFFE_????_ 01 -cell $_SDFFCE_????_ 01
opt_expr
opt_merge
opt_clean
tee -o /mnt/d/Project/hybrid_memory/paper2/reports/e8_rom/e8_5e/c1cache_stat_after_transform.txt stat

clockgate -liberty /home/kid/sky130/orfs/flow/platforms/sky130hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib -dont_use sky130_fd_sc_hd__sdlclkp*
tee -o /mnt/d/Project/hybrid_memory/paper2/reports/e8_rom/e8_5e/c1cache_stat_after_clockgate.txt stat

dfflibmap -liberty /home/kid/sky130/orfs/flow/platforms/sky130hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib -dont_use sky130_fd_sc_hd__lpflow_* -dont_use sky130_fd_sc_hd__probe*
abc -liberty /home/kid/sky130/orfs/flow/platforms/sky130hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib -dont_use sky130_fd_sc_hd__lpflow_* -dont_use sky130_fd_sc_hd__probe*
