tee -o /mnt/d/Project/hybrid_memory/paper2/reports/e8_rom/e8_5e/c1cache_stat_final.txt stat -liberty /home/kid/sky130/orfs/flow/platforms/sky130hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
write_verilog /mnt/d/Project/hybrid_memory/paper2/reports/e8_rom/e8_5e/conv1_cache_netlist.v
