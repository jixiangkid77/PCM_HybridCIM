# =============================================================
# P2R-E3 stage 2, variant: gated. Yosys 0.68+36.
#
# Reads back the stage 1 design and finishes technology mapping.
# Two netlists are written from this one run so that the gate-level
# simulation and the static timing analysis are guaranteed to read
# the same design:
#   lenet5_top_gated_netlist.v   with attributes, for iverilog
#   lenet5_top_gated_sta.v       -noattr, for OpenSTA
# =============================================================
read_liberty -lib /home/kid/sky130/orfs/flow/platforms/sky130hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
read_rtlil /home/kid/p2r_build/e3_gated_s1.rtlil

dfflibmap -liberty /home/kid/sky130/orfs/flow/platforms/sky130hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib -dont_use sky130_fd_sc_hd__lpflow_* -dont_use sky130_fd_sc_hd__probe*
abc -liberty /home/kid/sky130/orfs/flow/platforms/sky130hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib -dont_use sky130_fd_sc_hd__lpflow_* -dont_use sky130_fd_sc_hd__probe*
clean

tee -o reports/e3_gated_stat_final.txt stat -liberty /home/kid/sky130/orfs/flow/platforms/sky130hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib

write_verilog reports/lenet5_top_gated_netlist.v
write_verilog -noattr reports/lenet5_top_gated_sta.v
